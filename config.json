      "indent_size": 2,
      "phase": 2,
      "disable": false,
      "fixable": true,
      "severity": "Error",
      "user_error_message": "",
      "number_of_spaces": "1"
    },
    "constant_006": {
      "indent_style": "spaces",
      "indent_size": 2,
      "phase": 2,
      "disable": false,
      "fixable": true,
      "severity": "Error",
      "user_error_message": "",
      "number_of_spaces": "1"
    }

  }
